{
  "name": "@kineco-au/osgridref-converter",
  "version": "1.0.1",
  "description": "Converts to and from OS Grid Refs and WGS84 (latitude and longitude) coordinate systems",
  "keywords": [
    "ordnance-survey",
    "osgb36",
    "wgs84",
    "grid-reference",
    "easting-northing",
    "latitude-longitude",
    "coordinates",
    "geospatial",
    "gis",
    "uk"
  ],
  "homepage": "https://github.com/kineco-au/osgridref-converter#readme",
  "bugs": "https://github.com/kineco-au/osgridref-converter/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kineco-au/osgridref-converter.git"
  },
  "author": "Kineco Pty Ltd",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build ./src/index.ts --outdir ./dist --target node",
    "build:types": "tsc --project tsconfig.build.json",
    "format": "biome check",
    "format:fix": "biome check --write",
    "release": "bun run scripts/release.ts",
    "test": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "latest",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
